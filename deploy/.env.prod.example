# Copier ce fichier sur le serveur sous ~/streemi/.env.prod et remplacer TOUTES les valeurs.
# Générer un secret : openssl rand -hex 32

###> Symfony ###
APP_SECRET=a_remplacer_par_openssl_rand_hex_32
# Nom de domaine pointant vers l'IP du serveur (HTTPS automatique)
SERVER_NAME=streemi.mondomaine.fr
TRUSTED_HOSTS='^streemi\.mondomaine\.fr$'

###> Base de données ###
POSTGRES_DB=streemi
POSTGRES_USER=streemi
POSTGRES_PASSWORD=a_remplacer_par_un_mot_de_passe_long
DATABASE_URL="postgresql://streemi:a_remplacer_par_un_mot_de_passe_long@database:5432/streemi?serverVersion=16&charset=utf8"

###> Emails (ex. Gmail avec un mot de passe d'application) ###
MAILER_DSN=smtp://ton.adresse%40gmail.com:motdepasseapplication@smtp.gmail.com:587

###> Connexion Google ###
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

###> Assistant IA ###
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
