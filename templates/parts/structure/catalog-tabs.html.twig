{# Onglets Séries / Films / Animés : recharge la page courante avec ?type=... #}
<nav class="flex space-x-6 text-gray-400 font-medium">
    {% for tab in ['serie', 'movie', 'anime'] %}
        {% set tabType = enum('App\\Enum\\CatalogTypeEnum').from(tab) %}
        <a href="{{ path(app.current_route, {type: tab}) }}"
           class="{{ tabType == type ? 'text-gray-700 font-semibold' : 'hover:text-gray-700' }}">{{ tabType.label }}</a>
    {% endfor %}
</nav>
