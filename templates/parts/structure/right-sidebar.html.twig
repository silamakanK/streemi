<aside class="w-1/5 py-10 px-8 min-w-min border-l border-gray-300 hidden lg:block">

    {% if app.user %}
    <a href="{{ path('profile') }}" class="flex items-center gap-3 mb-8 group">
        <div class="w-10 h-10 rounded-full bg-red-100 text-red-600 font-bold flex items-center justify-center text-lg shrink-0">
            {{ app.user.username|first|upper }}
        </div>
        <div>
            <div class="font-semibold text-gray-900 group-hover:text-red-600 transition text-sm">{{ app.user.username }}</div>
            <div class="text-xs text-gray-400">
                {% if app.user.currentSubscription %}
                    {{ app.user.currentSubscription.name }}
                {% else %}
                    Aucun abonnement
                {% endif %}
            </div>
        </div>
    </a>
    {% endif %}

    <form method="GET" action="{{ path('search') }}" class="relative flex items-center">
        <span class="text-gray-400 absolute left-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
        </span>
        <input type="text" name="q" class="text-xs ring-1 bg-transparent ring-gray-200 focus:ring-red-300 pl-10 pr-5 text-gray-600 py-3 rounded-full w-full outline-none" placeholder="Rechercher...">
    </form>

    {% if app.user %}
    <div class="mt-8">
        <div class="flex items-center justify-between mb-4">
            <span class="font-semibold text-gray-700 text-sm">Récemment regardé</span>
            <a href="{{ path('watch_history') }}" class="text-xs text-red-600 hover:underline">Tout voir</a>
        </div>
        {% set history = app.user.watchHistories %}
        {% if history|length > 0 %}
        <ul class="space-y-3 text-xs">
            {% for entry in history|slice(0, 3) %}
            <li>
                <a href="{{ path('movie_detail', {id: entry.media.id}) }}"
                   class="flex space-x-3 transition cursor-pointer hover:bg-black/5 rounded-lg p-1">
                    <img src="{{ entry.media.coverImage }}" class="w-12 h-16 object-cover rounded-md shrink-0" alt="{{ entry.media.title }}">
                    <div class="flex flex-col justify-between py-0.5 min-w-0">
                        <span class="text-gray-700 font-semibold truncate">{{ entry.media.title }}</span>
                        <span class="text-gray-400">{{ entry.numberOfViews }} visionnage{{ entry.numberOfViews > 1 ? 's' : '' }}</span>
                        <span class="text-gray-400">{{ entry.lastWatchedAt|date('d/m/Y') }}</span>
                    </div>
                </a>
            </li>
            {% endfor %}
        </ul>
        {% else %}
        <p class="text-xs text-gray-400">Aucun visionnage pour l'instant.</p>
        {% endif %}
    </div>

    <div class="mt-8">
        <div class="flex items-center justify-between mb-4">
            <span class="font-semibold text-gray-700 text-sm">Mes playlists</span>
            <a href="{{ path('show_my_list') }}" class="text-xs text-red-600 hover:underline">Gérer</a>
        </div>
        {% set playlists = app.user.playlists %}
        {% if playlists|length > 0 %}
        <ul class="space-y-2">
            {% for playlist in playlists|slice(0, 4) %}
            <li>
                <a href="{{ path('show_my_list', {playlist: playlist.id}) }}"
                   class="flex items-center gap-2 text-xs text-gray-600 hover:text-red-600 transition py-1">
                    <svg class="h-4 w-4 fill-current shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M17,3H7A2,2 0 0,0 5,5V21L12,18L19,21V5C19,3.89 18.1,3 17,3Z"/></svg>
                    <span class="truncate">{{ playlist.name }}</span>
                    <span class="text-gray-400 shrink-0">({{ playlist.playlistMedia|length }})</span>
                </a>
            </li>
            {% endfor %}
        </ul>
        {% else %}
        <p class="text-xs text-gray-400">Aucune playlist.</p>
        {% endif %}
    </div>
    {% else %}
    <div class="mt-8 text-center">
        <p class="text-sm text-gray-500 mb-4">Connectez-vous pour accéder à vos listes et historique.</p>
        <a href="{{ path('app_login') }}" class="block px-4 py-2 bg-red-600 hover:bg-red-700 text-white text-sm rounded-lg transition">
            Se connecter
        </a>
        <a href="{{ path('register') }}" class="block mt-2 px-4 py-2 border border-red-600 text-red-600 hover:bg-red-50 text-sm rounded-lg transition">
            S'inscrire
        </a>
    </div>
    {% endif %}

</aside>
