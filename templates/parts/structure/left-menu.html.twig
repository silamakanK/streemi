{% set route = app.request ? app.request.attributes.get('_route') : '' %}

<aside class="w-1/6 py-10 pl-10 min-w-min border-r border-gray-300 hidden md:block">
    <a class="font-bold text-lg flex items-center gap-x-3" href="{{ path('homepage') }}">
        <svg class="h-8 w-8 fill-red-600" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <path d="M10 15.5v-7c0-.41.47-.65.8-.4l4.67 3.5c.27.2.27.6 0 .8l-4.67 3.5c-.33.25-.8.01-.8-.4Zm11.96-4.45c.58 6.26-4.64 11.48-10.9 10.9 -4.43-.41-8.12-3.85-8.9-8.23 -.26-1.42-.19-2.78.12-4.04 .14-.58.76-.9 1.31-.7v0c.47.17.75.67.63 1.16 -.2.82-.27 1.7-.19 2.61 .37 4.04 3.89 7.25 7.95 7.26 4.79.01 8.61-4.21 7.94-9.12 -.51-3.7-3.66-6.62-7.39-6.86 -.83-.06-1.63.02-2.38.2 -.49.11-.99-.16-1.16-.64v0c-.2-.56.12-1.17.69-1.31 1.79-.43 3.75-.41 5.78.37 3.56 1.35 6.15 4.62 6.5 8.4ZM5.5 4C4.67 4 4 4.67 4 5.5 4 6.33 4.67 7 5.5 7 6.33 7 7 6.33 7 5.5 7 4.67 6.33 4 5.5 4Z"></path>
        </svg>
        <div class="tracking-wide">Streemi<span class="text-red-600">.</span></div>
    </a>

    <nav class="mt-12 flex flex-col gap-y-4 text-gray-500 fill-gray-500 text-sm">

        <div class="text-gray-400/70 font-medium uppercase text-xs">Menu</div>

        <a class="flex items-center space-x-2 py-1 group hover:border-r-4 hover:border-r-red-600 hover:font-semibold pr-4
            {{ route == 'homepage' ? 'font-semibold border-r-4 border-r-red-600 fill-red-600 text-red-600' : '' }}"
           href="{{ path('homepage') }}">
            <svg class="h-5 w-5 {{ route == 'homepage' ? 'fill-red-600' : 'group-hover:fill-red-600' }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <path d="M5 22h14c1.1 0 2-.9 2-2v-9c0-.27-.11-.53-.29-.71l-8-8c-.4-.39-1.02-.39-1.41 0l-8 8c-.2.18-.3.44-.3.71v9c0 1.1.89 2 2 2Zm5-2v-5h4v5Zm-5-8.59l7-7 7 7V20h-3v-5c0-1.11-.9-2-2-2h-4c-1.11 0-2 .89-2 2v5H5Z"></path>
            </svg>
            <span>Accueil</span>
        </a>

        <a class="flex items-center space-x-2 py-1 group hover:border-r-4 hover:border-r-red-600 hover:font-semibold pr-4
            {{ route == 'movie_discover' ? 'font-semibold border-r-4 border-r-red-600 fill-red-600 text-red-600' : '' }}"
           href="{{ path('movie_discover') }}">
            <svg class="h-5 w-5 {{ route == 'movie_discover' ? 'fill-red-600' : 'group-hover:fill-red-600' }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <path d="M12 2C6.48 2 2 6.48 2 12c0 5.51 4.48 10 10 10 5.51 0 10-4.49 10-10 0-5.52-4.49-10-10-10Zm0 18c-4.42 0-8-3.59-8-8 0-4.42 3.58-8 8-8 4.41 0 8 3.58 8 8 0 4.41-3.59 8-8 8Z"></path>
                <path d="M8 16l5.991-2 2-6 -6 2Z"></path>
            </svg>
            <span>Découvrir</span>
        </a>

        {% if app.user %}
        <a class="flex items-center space-x-2 py-1 group hover:border-r-4 hover:border-r-red-600 hover:font-semibold pr-4
            {{ route == 'show_my_list' ? 'font-semibold border-r-4 border-r-red-600 fill-red-600 text-red-600' : '' }}"
           href="{{ path('show_my_list') }}">
            <svg class="h-5 w-5 {{ route == 'show_my_list' ? 'fill-red-600' : 'group-hover:fill-red-600' }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <path d="M17,3H7A2,2 0 0,0 5,5V21L12,18L19,21V5C19,3.89 18.1,3 17,3Z"/>
            </svg>
            <span>Mes listes</span>
        </a>

        <a class="flex items-center space-x-2 py-1 group hover:border-r-4 hover:border-r-red-600 hover:font-semibold pr-4
            {{ route == 'watch_history' ? 'font-semibold border-r-4 border-r-red-600 fill-red-600 text-red-600' : '' }}"
           href="{{ path('watch_history') }}">
            <svg class="h-5 w-5 {{ route == 'watch_history' ? 'fill-red-600' : 'group-hover:fill-red-600' }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <path d="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M16.2,16.2L11,13V7H12.5V12.2L17,14.9L16.2,16.2Z"/>
            </svg>
            <span>Historique</span>
        </a>
        {% endif %}

        <div class="mt-4 text-gray-400/70 font-medium uppercase text-xs">Compte</div>

        <a class="flex items-center space-x-2 py-1 group hover:border-r-4 hover:border-r-red-600 hover:font-semibold pr-4
            {{ route == 'show_subscriptions' ? 'font-semibold border-r-4 border-r-red-600 fill-red-600 text-red-600' : '' }}"
           href="{{ path('show_subscriptions') }}">
            <svg class="h-5 w-5 {{ route == 'show_subscriptions' ? 'fill-red-600' : 'group-hover:fill-red-600' }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <path d="M20,8H4V6H20M20,18H4V12H20M20,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V6C22,4.89 21.1,4 20,4Z"/>
            </svg>
            <span>Abonnements</span>
        </a>

        {% if app.user %}
        <a class="flex items-center space-x-2 py-1 group hover:border-r-4 hover:border-r-red-600 hover:font-semibold pr-4
            {{ route == 'profile' ? 'font-semibold border-r-4 border-r-red-600 fill-red-600 text-red-600' : '' }}"
           href="{{ path('profile') }}">
            <svg class="h-5 w-5 {{ route == 'profile' ? 'fill-red-600' : 'group-hover:fill-red-600' }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <path d="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z"/>
            </svg>
            <span>Mon profil</span>
        </a>
        {% endif %}

        {% if is_granted('ROLE_ADMIN') %}
        <a class="flex items-center space-x-2 py-1 group hover:border-r-4 hover:border-r-red-600 hover:font-semibold pr-4
            {{ route starts with 'admin' ? 'font-semibold border-r-4 border-r-red-600 fill-red-600 text-red-600' : '' }}"
           href="{{ path('admin') }}">
            <svg class="h-5 w-5 {{ route starts with 'admin' ? 'fill-red-600' : 'group-hover:fill-red-600' }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <path d="M12,2A2,2 0 0,1 14,4A2,2 0 0,1 12,6A2,2 0 0,1 10,4A2,2 0 0,1 12,2M10.5,7H13.5C14.6,7 15.5,7.9 15.5,9V14.5H14V22H10V14.5H8.5V9C8.5,7.9 9.4,7 10.5,7Z"/>
            </svg>
            <span>Administration</span>
        </a>
        {% endif %}

        <div class="mt-4 text-gray-400/70 font-medium uppercase text-xs">Session</div>

        {% if app.user %}
        <a href="{{ path('app_logout') }}"
           class="flex items-center space-x-2 py-1 group hover:border-r-4 hover:border-r-red-600 hover:font-semibold pr-4">
            <svg class="h-5 w-5 group-hover:fill-red-600" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <path d="M16 13v-2H7V8l-5 4 5 4v-3Z"></path>
                <path d="M20 3h-9c-1.11 0-2 .89-2 2v4h2V5h9v14h-9v-4H9v4c0 1.1.89 2 2 2h9c1.1 0 2-.9 2-2V5c0-1.11-.9-2-2-2Z"></path>
            </svg>
            <span>Déconnexion</span>
        </a>
        {% else %}
        <a href="{{ path('app_login') }}"
           class="flex items-center space-x-2 py-1 group hover:border-r-4 hover:border-r-red-600 hover:font-semibold pr-4">
            <svg class="h-5 w-5 group-hover:fill-red-600" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <path d="M16 13v-2H7V8l-5 4 5 4v-3Z"></path>
                <path d="M20 3h-9c-1.11 0-2 .89-2 2v4h2V5h9v14h-9v-4H9v4c0 1.1.89 2 2 2h9c1.1 0 2-.9 2-2V5c0-1.11-.9-2-2-2Z"></path>
            </svg>
            <span>Connexion</span>
        </a>
        <a href="{{ path('register') }}"
           class="flex items-center space-x-2 py-1 group hover:border-r-4 hover:border-r-red-600 hover:font-semibold pr-4">
            <svg class="h-5 w-5 group-hover:fill-red-600" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <path d="M15,14C12.33,14 7,15.33 7,18V20H23V18C23,15.33 17.67,14 15,14M6,10V7H4V10H1V12H4V15H6V12H9V10M15,12A4,4 0 0,0 19,8A4,4 0 0,0 15,4A4,4 0 0,0 11,8A4,4 0 0,0 15,12Z"/>
            </svg>
            <span>S'inscrire</span>
        </a>
        {% endif %}

    </nav>
</aside>
