<li class="flex flex-col rounded-xl border overflow-hidden hover:shadow-md transition
    {{ app.user and app.user.currentSubscription and app.user.currentSubscription.id == subscription.id
        ? 'border-red-500 ring-2 ring-red-500'
        : 'border-gray-200' }}">
    <div class="p-6 flex-1">
        <div class="flex items-start justify-between">
            <div>
                <h3 class="font-bold text-gray-900 text-base">{{ subscription.name }}</h3>
                <p class="text-gray-500 text-sm mt-1">{{ subscription.description }}</p>
            </div>
            {% if app.user and app.user.currentSubscription and app.user.currentSubscription.id == subscription.id %}
                <span class="px-2 py-1 bg-red-100 text-red-600 text-xs font-medium rounded-full shrink-0 ml-2">Actif</span>
            {% endif %}
        </div>
        <div class="mt-4 flex items-baseline gap-1">
            <span class="text-3xl font-bold text-red-600">{{ subscription.price }}€</span>
            <span class="text-gray-400 text-sm">/ {{ subscription.duration }} mois</span>
        </div>
    </div>
    {% if app.user %}
        {% if app.user.currentSubscription and app.user.currentSubscription.id == subscription.id %}
        <div class="px-6 pb-5">
            <span class="block text-center py-2.5 bg-gray-100 text-gray-500 text-sm rounded-lg">Abonnement actuel</span>
        </div>
        {% else %}
        <div class="px-6 pb-5">
            <form method="POST" action="{{ path('subscription_subscribe', {id: subscription.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('subscribe_' ~ subscription.id) }}">
                <button type="submit"
                        class="w-full py-2.5 bg-red-600 hover:bg-red-700 text-white text-sm rounded-lg transition font-medium">
                    Choisir cet abonnement
                </button>
            </form>
        </div>
        {% endif %}
    {% else %}
    <div class="px-6 pb-5">
        <a href="{{ path('app_login') }}"
           class="block text-center py-2.5 bg-red-600 hover:bg-red-700 text-white text-sm rounded-lg transition">
            Se connecter pour souscrire
        </a>
    </div>
    {% endif %}
</li>
