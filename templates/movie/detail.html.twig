{% extends 'base.html.twig' %}

{% block title %} Streemi - {{ media.title }} {% endblock %}

{% block content %}
<div class="flex min-h-screen 2xl:max-w-screen-2xl 2xl:mx-auto 2xl:border-x-2 2xl:border-gray-200">
    <main class="flex-1 py-10 px-5 sm:px-10">

        <section>
            <h1 class="text-lg font-medium text-black">Détails de <span class="font-bold text-red-600">{{ media.title }}</span></h1>
        </section>

        <section class="mt-9">
            <div class="flex flex-col justify-between mt-4 bg-black/10 bg-blend-multiply h-96 overflow-hidden bg-cover bg-center px-7 pt-4 pb-6 text-white -ml-5 -mr-5 sm:-ml-10 sm:-mr-10 rounded-none"
                 style="background-image: url('{{ media.coverImage }}');">
                <div></div>
                <div class="bg-gradient-to-r from-black/60 to-transparent -mx-7 -mb-6 px-7 pb-6 pt-4">
                    <span class="uppercase text-3xl font-semibold drop-shadow-lg">{{ media.title }}</span>
                    <div class="text-sm text-gray-300 mt-1">
                        {% for category in media.categories %}
                            <span>{{ category.nom }}</span>{% if not loop.last %}, {% endif %}
                        {% endfor %}
                        · {{ media.releaseDate|date('Y') }}
                    </div>
                    <div class="mt-4 flex items-center gap-3 flex-wrap">
                        {% if app.user %}
                        <form method="POST" action="{{ path('media_watch', {id: media.id}) }}">
                            <button type="submit" class="px-5 flex items-center py-2.5 bg-red-600 hover:bg-red-700 rounded-lg text-xs">
                                <svg class="h-5 w-5 fill-current mr-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M8,5.14V19.14L19,12.14L8,5.14Z"/></svg>
                                Regarder
                            </button>
                        </form>
                        {% else %}
                        <a href="{{ path('app_login') }}" class="px-5 flex items-center py-2.5 bg-red-600 hover:bg-red-700 rounded-lg text-xs">
                            <svg class="h-5 w-5 fill-current mr-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M8,5.14V19.14L19,12.14L8,5.14Z"/></svg>
                            Regarder
                        </a>
                        {% endif %}
                        <span class="bg-white/30 py-1 px-3 text-xs rounded">{{ media.validatedComments|length }} commentaires</span>
                        {% if watchEntry %}
                        <span class="bg-white/30 py-1 px-3 text-xs rounded">{{ watchEntry.numberOfViews }} visionnage{{ watchEntry.numberOfViews > 1 ? 's' : '' }}</span>
                        {% endif %}
                    </div>
                </div>
            </div>
        </section>

        {% if media.mediaType == 'Serie' %}
        <section class="mt-9">
            <div class="max-w-3xl mx-auto">
                <h2 class="text-lg font-medium text-black">Les <span class="font-bold text-red-600">épisodes</span></h2>
                {% for season in media.seasons %}
                    <h3 class="font-semibold mt-6 mb-3 text-gray-700">{{ season.number }}</h3>
                    <ul class="space-y-3">
                        {% for episode in season.episodes %}
                        <li class="flex flex-row gap-4 p-4 rounded-lg transition cursor-pointer hover:bg-gray-100 border">
                            <div class="relative flex rounded-xl w-24 h-16 overflow-hidden bg-gray-200 shrink-0 items-center justify-center">
                                <svg class="h-8 w-8 fill-gray-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M8,5.14V19.14L19,12.14L8,5.14Z"/></svg>
                            </div>
                            <div class="flex flex-col justify-center">
                                <span class="font-bold">{{ episode.title }}</span>
                                <span class="text-sm text-gray-500">{{ episode.duration }} min</span>
                            </div>
                        </li>
                        {% endfor %}
                    </ul>
                {% else %}
                    <p class="text-gray-400 mt-4">Aucune saison disponible.</p>
                {% endfor %}
            </div>
        </section>
        {% endif %}

        <section class="mt-9">
            <div class="max-w-3xl mx-auto">
                <h2 class="text-lg font-medium text-black"><span class="font-bold text-red-600">Infos</span></h2>
                <div class="flex flex-wrap gap-2 mt-4">
                    <span class="bg-black/10 px-2 py-1 rounded text-sm"><b>Sortie</b> {{ media.releaseDate|date("d/m/Y") }}</span>
                    <span class="bg-black/10 px-2 py-1 rounded text-sm">
                        <b>Langues</b>
                        {% for language in media.languages %}{{ language.nom }}{% if not loop.last %}, {% endif %}{% endfor %}
                    </span>
                    <span class="bg-black/10 px-2 py-1 rounded text-sm">
                        <b>Catégories</b>
                        {% for category in media.categories %}
                            <a href="{{ path('show_category', {id: category.id}) }}" class="hover:text-red-600 underline decoration-red-400">{{ category.nom }}</a>{% if not loop.last %}, {% endif %}
                        {% endfor %}
                    </span>
                </div>
            </div>

            <div class="max-w-3xl mx-auto mt-9">
                <h2 class="text-lg font-medium text-black">Résumé <span class="font-bold text-red-600">rapide</span></h2>
                <p class="text-sm mt-4 text-gray-700 leading-relaxed">{{ media.shortDescription }}</p>
            </div>

            {% if media.staff|length > 0 %}
            <div class="max-w-3xl mx-auto mt-9">
                <h2 class="text-lg font-medium text-black"><span class="font-bold text-red-600">Équipe</span></h2>
                <ul class="mt-4 grid grid-cols-2 sm:grid-cols-4 gap-4">
                    {% for member in media.staff %}
                    <li class="relative rounded-xl overflow-hidden aspect-square cursor-pointer hover:scale-105 transition hover:shadow-md">
                        <img src="{{ member.image }}" class="object-cover h-full w-full" alt="{{ member.name }}">
                        <div class="absolute inset-0 bg-gradient-to-t from-black/60 p-3 flex flex-col justify-end items-center text-center">
                            <span class="text-white font-medium text-sm drop-shadow">{{ member.name }}</span>
                            <span class="text-gray-300 text-xs">{{ member.role }}</span>
                        </div>
                    </li>
                    {% endfor %}
                </ul>
            </div>
            {% endif %}

            {% if media.casting|length > 0 %}
            <div class="max-w-3xl mx-auto mt-9">
                <h2 class="text-lg font-medium text-black">Le <span class="font-bold text-red-600">Casting</span></h2>
                <ul class="mt-4 grid grid-cols-2 sm:grid-cols-4 gap-4">
                    {% for actor in media.casting %}
                    <li class="relative rounded-xl overflow-hidden aspect-square cursor-pointer hover:scale-105 transition hover:shadow-md">
                        <img src="{{ actor.image }}" class="object-cover h-full w-full" alt="{{ actor.name }}">
                        <div class="absolute inset-0 bg-gradient-to-t from-black/60 p-3 flex flex-col justify-end items-center text-center">
                            <span class="text-white font-medium text-sm drop-shadow">{{ actor.name }}</span>
                            <span class="text-gray-300 text-xs">{{ actor.role }}</span>
                        </div>
                    </li>
                    {% endfor %}
                </ul>
            </div>
            {% endif %}

            <div class="max-w-3xl mx-auto mt-9">
                <h2 class="text-lg font-medium text-black">Résumé <span class="font-bold text-red-600">détaillé</span></h2>
                <p class="text-sm mt-4 text-gray-700 leading-relaxed">{{ media.longDescription }}</p>
            </div>
        </section>

        {% if app.user %}
        <section class="mt-9">
            <div class="max-w-3xl mx-auto">
                <h2 class="text-lg font-medium text-black">Ajouter à <span class="font-bold text-red-600">ma liste</span></h2>
                {% if playlists|length > 0 %}
                <form method="POST" class="mt-4 flex gap-3 items-center" id="addToPlaylistForm">
                    <select name="playlistId" id="playlistSelect"
                            class="flex-1 px-4 py-2.5 rounded-lg border border-gray-200 text-sm focus:outline-none focus:border-red-400">
                        {% for playlist in playlists %}
                            <option value="{{ playlist.id }}">{{ playlist.name }}</option>
                        {% endfor %}
                    </select>
                    <button type="submit" class="px-5 py-2.5 bg-red-600 hover:bg-red-700 text-white text-sm rounded-lg transition flex items-center gap-2">
                        <svg class="h-4 w-4 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M17,13H13V17H11V13H7V11H11V7H13V11H17M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z"/></svg>
                        Ajouter
                    </button>
                </form>
                <script>
                    document.getElementById('addToPlaylistForm').addEventListener('submit', function(e) {
                        e.preventDefault();
                        const playlistId = document.getElementById('playlistSelect').value;
                        const form = document.createElement('form');
                        form.method = 'POST';
                        form.action = '/lists/' + playlistId + '/add/{{ media.id }}';
                        const input = document.createElement('input');
                        input.type = 'hidden'; input.name = 'redirect'; input.value = 'detail';
                        form.appendChild(input);
                        document.body.appendChild(form);
                        form.submit();
                    });
                </script>
                {% else %}
                <p class="mt-4 text-sm text-gray-500">
                    Vous n'avez pas encore de playlist.
                    <a href="{{ path('show_my_list') }}" class="text-red-600 hover:underline">Créez-en une</a>.
                </p>
                {% endif %}
            </div>
        </section>
        {% endif %}

        <section class="mt-9">
            <div class="max-w-3xl mx-auto">
                <h2 class="text-lg font-medium text-black">Les <span class="font-bold text-red-600">commentaires</span>
                    <span class="text-sm font-normal text-gray-400">({{ media.validatedComments|length }})</span>
                </h2>

                <ul class="space-y-4 mt-6">
                    {% for comment in media.validatedComments %}
                    <li class="bg-gray-100 p-4 rounded-lg">
                        <div class="flex items-center gap-3">
                            <div class="w-9 h-9 rounded-full bg-red-100 text-red-600 font-bold flex items-center justify-center">
                                {{ comment.publisher.username|first|upper }}
                            </div>
                            <span class="font-medium text-sm">{{ comment.publisher.username }}</span>
                        </div>
                        <p class="mt-3 text-sm text-gray-700">{{ comment.content }}</p>
                    </li>
                    {% else %}
                    <li class="text-gray-400 text-sm">Aucun commentaire pour l'instant.</li>
                    {% endfor %}
                </ul>

                {% if app.user %}
                <form class="mt-8 bg-gray-100 p-4 rounded-lg" method="POST" action="{{ path('media_comment_add', {id: media.id}) }}">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('comment_' ~ media.id) }}">
                    <h3 class="text-sm font-bold mb-3">Laisser un commentaire</h3>
                    <textarea name="content" rows="4" class="w-full px-4 py-3 rounded-lg border border-gray-200 bg-white text-sm focus:outline-none focus:border-red-400" placeholder="Votre commentaire..." required></textarea>
                    <div class="flex items-center justify-between mt-3">
                        <button class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white text-sm rounded-lg transition">
                            Envoyer
                        </button>
                        <span class="text-xs text-gray-400 italic">Visible après modération.</span>
                    </div>
                </form>
                {% else %}
                <div class="mt-6 bg-gray-50 border rounded-lg p-4 text-sm text-gray-500 text-center">
                    <a href="{{ path('app_login') }}" class="text-red-600 font-medium hover:underline">Connectez-vous</a> pour laisser un commentaire.
                </div>
                {% endif %}
            </div>
        </section>

    </main>
</div>
{% endblock %}
