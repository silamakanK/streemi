{% extends 'base.html.twig' %}

{% block title %} Streemi - Réinitialiser le mot de passe {% endblock %}

{% block content %}
<section class="h-full relative">
    <div style="background-image: url('https://blog.compose.fr/wp-content/uploads/2024/05/Marathon-Cinema.webp')"
         class="bg-cover bg-no-repeat h-full before:bg-black/40 before:content-[''] before:top-0 before:left-0 before:right-0 before:absolute before:w-full before:h-full">
        <div class="p-8 lg:w-1/2 mx-auto h-full flex items-center justify-center">
            <div class="bg-white rounded-lg p-8 relative w-full">
                <h1 class="text-center text-lg font-bold">Nouveau mot de passe</h1>

                {% if invalid %}
                    <div class="mt-6 bg-red-50 border border-red-200 text-red-700 px-4 py-4 rounded-lg text-sm text-center">
                        Ce lien de réinitialisation est invalide ou a expiré.
                    </div>
                    <div class="flex justify-center mt-6">
                        <a href="{{ path('forgot_password') }}" class="text-red-600 hover:underline text-sm">
                            Faire une nouvelle demande
                        </a>
                    </div>
                {% else %}
                    {% if error is defined and error %}
                        <div class="mt-4 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg text-sm">
                            {{ error }}
                        </div>
                    {% endif %}

                    <p class="text-center text-sm text-gray-500 mt-3">
                        Choisissez un mot de passe d'au moins 6 caractères.
                    </p>

                    <form class="mt-8 space-y-4" method="POST" action="{{ path('reset_password') }}">
                        <input type="hidden" name="token" value="{{ token }}">

                        <div class="relative">
                            <input class="w-full px-8 py-4 rounded-lg font-medium bg-gray-100 border border-gray-200 placeholder-gray-500 text-sm focus:outline-none focus:border-gray-400 focus:bg-white"
                                   id="reset-password" name="password" type="password" placeholder="Nouveau mot de passe" required minlength="6"/>
                            <button type="button" onclick="togglePassword('reset-password', this)" class="absolute right-2 inset-y-0 flex items-center px-2 opacity-50 hover:opacity-100 transition">
                                <svg class="h-5 w-5 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9M12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5Z"/></svg>
                            </button>
                        </div>
                        <div class="relative">
                            <input class="w-full px-8 py-4 rounded-lg font-medium bg-gray-100 border border-gray-200 placeholder-gray-500 text-sm focus:outline-none focus:border-gray-400 focus:bg-white"
                                   id="reset-password-confirm" name="password_confirm" type="password" placeholder="Confirmez le mot de passe" required/>
                            <button type="button" onclick="togglePassword('reset-password-confirm', this)" class="absolute right-2 inset-y-0 flex items-center px-2 opacity-50 hover:opacity-100 transition">
                                <svg class="h-5 w-5 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9M12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5Z"/></svg>
                            </button>
                        </div>

                        <button type="submit"
                                class="relative flex w-full bg-red-600 flex-row p-3 items-center justify-center rounded-lg text-white hover:bg-red-700 transition">
                            <svg class="h-5 w-5 fill-current mr-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 2C6.5 2 2 6.5 2 12S6.5 22 12 22 22 17.5 22 12 17.5 2 12 2M10 17L5 12L6.41 10.59L10 14.17L17.59 6.58L19 8L10 17Z"/></svg>
                            Changer mon mot de passe
                        </button>

                        <div class="flex justify-center mt-4">
                            <a href="{{ path('app_login') }}" class="text-red-600 hover:underline text-sm">
                                Retour à la connexion
                            </a>
                        </div>
                    </form>
                {% endif %}
            </div>
        </div>
    </div>
</section>

<script>
function togglePassword(inputId, btn) {
    const input = document.getElementById(inputId);
    const isHidden = input.type === 'password';
    input.type = isHidden ? 'text' : 'password';
    btn.style.opacity = isHidden ? '1' : '0.5';
}
</script>
{% endblock %}
