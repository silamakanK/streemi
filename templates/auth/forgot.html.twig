{% extends 'base.html.twig' %}

{% block title %} Streemi - Mot de passe oublié {% endblock %}

{% block content %}
<section class="h-full relative">
    <div style="background-image: url('https://blog.compose.fr/wp-content/uploads/2024/05/Marathon-Cinema.webp')"
         class="bg-cover bg-no-repeat h-full before:bg-black/40 before:content-[''] before:top-0 before:left-0 before:right-0 before:absolute before:w-full before:h-full">
        <div class="p-8 lg:w-1/2 mx-auto h-full flex items-center justify-center">
            <div class="bg-white rounded-lg p-8 relative w-full">
                <h1 class="text-center text-lg font-bold">Mot de passe oublié ?</h1>
                <p class="text-center text-sm font-medium opacity-70 mt-3">
                    Entrez votre email et vous recevrez un lien de réinitialisation.
                </p>

                {% if sent %}
                    <div class="mt-6 bg-green-50 border border-green-200 text-green-700 px-4 py-4 rounded-lg text-sm text-center">
                        Si un compte existe avec cet email, vous recevrez un lien dans quelques instants.
                        <br>Vérifiez votre boîte mail (et les spams).
                    </div>
                    <div class="flex justify-center mt-6">
                        <a href="{{ path('app_login') }}" class="text-red-600 hover:underline text-sm">
                            Retour à la connexion
                        </a>
                    </div>
                {% else %}
                    <form class="mt-8" method="POST" action="{{ path('forgot_password') }}">
                        <div class="relative">
                            <input class="w-full px-8 py-4 rounded-lg font-medium bg-gray-100 border border-gray-200 placeholder-gray-500 text-sm focus:outline-none focus:border-gray-400 focus:bg-white"
                                   name="email" type="email" placeholder="Adresse email" required/>
                        </div>
                        <div class="flex items-center justify-center mt-6">
                            <button type="submit"
                                    class="relative flex w-full bg-red-600 flex-row p-3 items-center justify-center rounded-lg text-white hover:bg-red-700 transition">
                                <svg class="h-5 w-5 fill-current mr-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M13 19C13 15.69 15.69 13 19 13C20.1 13 21.12 13.3 22 13.81V6C22 4.89 21.1 4 20 4H4C2.89 4 2 4.89 2 6V18C2 19.11 2.9 20 4 20H13.09C13.04 19.67 13 19.34 13 19M4 8V6L12 11L20 6V8L12 13L4 8M20 22V20H16V18H20V16L23 19L20 22Z"/></svg>
                                Recevoir le lien
                            </button>
                        </div>
                        <div class="flex justify-center mt-8">
                            <a href="{{ path('app_login') }}" class="text-red-600 hover:underline text-sm">
                                Retour à la connexion
                            </a>
                        </div>
                    </form>
                {% endif %}
            </div>
        </div>
    </div>
</section>
{% endblock %}
