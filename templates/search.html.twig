{% extends 'base.html.twig' %}

{% block title %} Streemi - Recherche {% endblock %}

{% block content %}
<div class="flex min-h-screen 2xl:max-w-screen-2xl 2xl:mx-auto">
    <main class="flex-1 py-10 px-5 sm:px-10">

        <form method="GET" action="{{ path('search') }}" class="flex gap-3 mb-9">
            <input type="text" name="q" value="{{ query }}" placeholder="Rechercher un film ou une série..."
                   autofocus
                   class="flex-1 px-5 py-3 rounded-lg border border-gray-200 text-sm focus:outline-none focus:border-red-400"/>
            <button type="submit"
                    class="px-6 py-3 bg-red-600 hover:bg-red-700 text-white text-sm rounded-lg transition">
                Rechercher
            </button>
        </form>

        {% if query %}
            <h1 class="text-lg font-medium text-gray-900 mb-6">
                {{ results|length }} résultat{{ results|length != 1 ? 's' : '' }} pour
                <span class="font-bold text-red-600">« {{ query }} »</span>
            </h1>

            {% if results|length > 0 %}
                <ul class="grid grid-cols-2 gap-5 sm:grid-cols-3 lg:grid-cols-4">
                    {% for media in results %}
                        {% include 'parts/pages/movies/movie_card.html.twig' %}
                    {% endfor %}
                </ul>
            {% else %}
                <div class="text-center py-16 text-gray-400">
                    <svg class="h-16 w-16 fill-current mx-auto mb-4 opacity-30" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"/></svg>
                    <p class="text-lg">Aucun résultat pour « {{ query }} »</p>
                    <p class="text-sm mt-2">Essayez avec d'autres mots-clés.</p>
                </div>
            {% endif %}
        {% else %}
            <div class="text-center py-16 text-gray-400">
                <p>Tapez un titre pour commencer la recherche.</p>
            </div>
        {% endif %}

    </main>
    {% include 'parts/structure/right-sidebar.html.twig' %}
</div>
{% endblock %}
