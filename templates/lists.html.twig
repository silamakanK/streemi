{% extends 'base.html.twig' %}

{% block title %} Streemi - Mes listes {% endblock %}

{% block content %}
<div class="flex min-h-screen  2xl:max-w-screen-2xl 2xl:mx-auto 2xl:border-x-2 2xl:border-gray-200">

    <main class=" flex-1 py-10  px-5 sm:px-10 ">

        <header class=" font-bold text-lg flex items-center  gap-x-3 md:hidden mb-12 ">
                <span class="mr-6">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-gray-700 " fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7" />
                      </svg>
                </span>
            <svg class="h-8 w-8 fill-red-600 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <path d="M10 15.5v-7c0-.41.47-.65.8-.4l4.67 3.5c.27.2.27.6 0 .8l-4.67 3.5c-.33.25-.8.01-.8-.4Zm11.96-4.45c.58 6.26-4.64 11.48-10.9 10.9 -4.43-.41-8.12-3.85-8.9-8.23 -.26-1.42-.19-2.78.12-4.04 .14-.58.76-.9 1.31-.7v0c.47.17.75.67.63 1.16 -.2.82-.27 1.7-.19 2.61 .37 4.04 3.89 7.25 7.95 7.26 4.79.01 8.61-4.21 7.94-9.12 -.51-3.7-3.66-6.62-7.39-6.86 -.83-.06-1.63.02-2.38.2 -.49.11-.99-.16-1.16-.64v0c-.2-.56.12-1.17.69-1.31 1.79-.43 3.75-.41 5.78.37 3.56 1.35 6.15 4.62 6.5 8.4ZM5.5 4C4.67 4 4 4.67 4 5.5 4 6.33 4.67 7 5.5 7 6.33 7 7 6.33 7 5.5 7 4.67 6.33 4 5.5 4Z"></path>
            </svg>
            <div class="tracking-wide flex-1">MMovie<span class="text-red-600">.</span></div>

            <div class="relative items-center content-center flex ml-2">
                    <span class="text-gray-400 absolute left-4 cursor-pointer">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                        </svg>
                    </span>
                <input type="text" class="text-xs ring-1 bg-transparent ring-gray-200 focus:ring-red-300 pl-10 pr-5 text-gray-600 py-3 rounded-full w-full outline-none focus:ring-1" placeholder="Search ...">
            </div>
        </header>

        <section>
            <h1 class="font-medium text-black text-lg">Mes listes de <span class="font-bold text-red-600">films</span> et <span class="font-bold text-red-600">séries</span></h1>

            <div class="flex flex-col space-y-3 mt-9">
                <form method="POST" action="{{ path('playlist_create') }}" class="flex gap-2">
                    <input type="text" name="name" placeholder="Nom de la nouvelle liste..." required
                           class="flex-1 px-4 py-2.5 rounded-md border border-gray-200 text-sm focus:outline-none focus:border-red-400"/>
                    <button type="submit" class="flex items-center px-4 py-2.5 rounded-md border bg-red-600 text-white text-sm hover:bg-red-700 transition">
                        <svg class="fill-current h-4 w-4 mr-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M17,13H13V17H11V13H7V11H11V7H13V11H17M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z"/></svg>
                        Créer
                    </button>
                </form>

                <div class="relative w-full flex text-gray-700 font-medium">
                    <select id="choosePlaylistSelector" class="appearance-none w-full bg-white border border-gray-200 px-7 py-3 rounded-md shadow transition">
                        <option value="null">Selectionner une playlist</option>
                        {% set index = 1 %}

                        {% for playlist in myPlaylists %}
                            <option
                                    {% if selectedPlaylist and playlist.id == selectedPlaylist.id %} selected {% endif %}
                                    value="{{ playlist.id }}"
                            >#{{ index }} - {{ playlist.name }} (XX films & XX séries)</option>
                            {% set index = index + 1 %}
                        {% endfor %}

                        {% for subscribedPlaylist in subscribedPlaylists %}
                            <option
                                    {% if selectedPlaylist and subscribedPlaylist.id == selectedPlaylist.id %} selected {% endif %}
                                    value="{{ subscribedPlaylist.id }}">#{{ index }} - {{ subscribedPlaylist.name }} (XX films & XX séries) - Liste de {{ subscribedPlaylist.creator.username }}</option>
                            {% set index = index + 1 %}
                        {% endfor %}
                    </select>
                    <div class="pointer-events-none absolute right-2 inset-y-0 flex items-center px-2">
                        <svg class="fill-current h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><title>chevron-down-circle</title><path d="M22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2A10,10 0 0,1 22,12M6,10L12,16L18,10L16.6,8.6L12,13.2L7.4,8.6L6,10Z" /></svg>
                    </div>
                </div>
            </div>
        </section>

        {% if selectedPlaylist %}
            <section class="mt-9">
                <div class="flex items-center justify-between mb-4">
                    <h2 class="font-semibold text-gray-700">
                        {{ selectedPlaylist.name }}
                        <span class="text-sm font-normal text-gray-400">({{ selectedPlaylist.playlistMedia|length }} médias)</span>
                    </h2>
                    {% if selectedPlaylist.creator == app.user %}
                    <form method="POST" action="{{ path('playlist_delete', {id: selectedPlaylist.id}) }}"
                          onsubmit="return confirm('Supprimer cette playlist ?')">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete_playlist_' ~ selectedPlaylist.id) }}">
                        <button type="submit" class="text-xs text-red-500 hover:text-red-700 flex items-center gap-1">
                            <svg class="h-4 w-4 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"/></svg>
                            Supprimer la playlist
                        </button>
                    </form>
                    {% endif %}
                </div>

                <ul class="grid grid-cols-2 gap-y-5 sm:grid-cols-3 gap-x-5">
                    {% for playlistMedia in selectedPlaylist.playlistMedia %}
                        {% set media = playlistMedia.media %}
                        <li class="relative">
                            {% include 'parts/pages/movies/movie_card.html.twig' %}
                            {% if selectedPlaylist.creator == app.user %}
                            <form method="POST"
                                  action="{{ path('playlist_remove_media', {playlistId: selectedPlaylist.id, mediaId: media.id}) }}"
                                  class="absolute bottom-12 left-2">
                                <input type="hidden" name="_token" value="{{ csrf_token('remove_media_' ~ media.id) }}">
                                <button type="submit" title="Retirer de la playlist"
                                        class="p-1.5 bg-red-600 hover:bg-red-700 text-white rounded-full text-xs transition">
                                    <svg class="h-3 w-3 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"/></svg>
                                </button>
                            </form>
                            {% endif %}
                        </li>
                    {% else %}
                        <li class="col-span-3 text-gray-400 text-sm py-8 text-center">
                            Cette playlist est vide. Ajoutez des films depuis leur page de détail.
                        </li>
                    {% endfor %}
                </ul>
            </section>
        {% endif %}
    </main>

    {% include 'parts/structure/right-sidebar.html.twig' %}
</div>

<script>
    const choosePlaylistSelector = document.getElementById('choosePlaylistSelector');
    choosePlaylistSelector.addEventListener('change', (e) => {
        window.location.href = "{{ path('show_my_list') }}" + '?playlist=' + e.target.value;
    });
</script>
{% endblock %}