{% extends 'base.html.twig' %}

{% block title %} Streemi - {{ category.nom }} {% endblock %}

{% block content %}
<div class="flex min-h-screen 2xl:max-w-screen-2xl 2xl:mx-auto 2xl:border-x-2 2xl:border-gray-200">
    <main class="flex-1 py-10 px-5 sm:px-10">

        <section>
            <div class="flex flex-wrap items-center gap-3">
                <span class="font-bold text-red-600 text-lg">{{ category.nom }}</span>
                <nav class="flex flex-wrap gap-3">
                    {% for cat in allCategories %}
                        <a href="{{ path('show_category', {id: cat.id}) }}"
                           class="px-3 py-1 rounded-full text-sm font-medium transition
                                  {% if cat.id == category.id %}bg-red-600 text-white{% else %}bg-gray-100 text-gray-600 hover:bg-gray-200{% endif %}">
                            {{ cat.nom }}
                        </a>
                    {% endfor %}
                </nav>
            </div>
        </section>

        <section class="mt-9">
            <div class="flex items-center justify-between mb-4">
                <span class="font-semibold text-gray-700">
                    Films &amp; Séries — <span class="text-red-600">{{ category.nom }}</span>
                </span>
            </div>

            <ul id="movieList" class="mt-4 grid grid-cols-2 gap-y-5 sm:grid-cols-3 gap-x-5">
                {% for media in medias %}
                    {% include 'parts/pages/movies/movie_card.html.twig' %}
                {% else %}
                    <li class="col-span-3 text-center text-gray-400 py-12">Aucun média dans cette catégorie.</li>
                {% endfor %}
            </ul>

            {% if medias|length >= 9 %}
            <button id="loadMoreMovies" class="flex flex-col items-center mt-9 w-full">
                <div class="relative flex w-full bg-red-600 flex-row p-3 items-center justify-center rounded-lg overflow-hidden border cursor-pointer transition hover:bg-red-700 text-white">
                    <svg class="h-5 w-5 fill-current mr-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M17,13H13V17H11V13H7V11H11V7H13V11H17M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z"/></svg>
                    <span class="font-medium">Charger plus</span>
                </div>
            </button>
            {% endif %}
        </section>

    </main>
    {% include 'parts/structure/right-sidebar.html.twig' %}
</div>

{% if medias|length >= 9 %}
<script>
    const movieList = document.getElementById('movieList');
    const loadMoreBtn = document.getElementById('loadMoreMovies');
    let currentPage = 2;

    loadMoreBtn.addEventListener('click', () => {
        fetch(`{{ path('show_category_async', {id: category.id}) }}?page=${currentPage}`)
            .then(r => r.text())
            .then(html => {
                if (html.trim()) {
                    movieList.insertAdjacentHTML('beforeend', html);
                    currentPage++;
                } else {
                    loadMoreBtn.style.display = 'none';
                }
            });
    });
</script>
{% endif %}
{% endblock %}
