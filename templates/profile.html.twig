{% extends 'base.html.twig' %}

{% block title %} Streemi - Mon profil {% endblock %}

{% block content %}
<div class="flex min-h-screen 2xl:max-w-screen-2xl 2xl:mx-auto">
    <main class="flex-1 py-10 px-5 sm:px-10 max-w-2xl">

        <h1 class="text-lg font-medium text-black mb-9">Mon <span class="font-bold text-red-600">profil</span></h1>

        <div class="flex items-center gap-5 mb-10">
            <div class="w-20 h-20 rounded-full bg-red-100 text-red-600 font-bold flex items-center justify-center text-3xl">
                {{ app.user.username|first|upper }}
            </div>
            <div>
                <div class="text-xl font-bold text-gray-900">{{ app.user.username }}</div>
                <div class="text-sm text-gray-500">{{ app.user.email }}</div>
                <div class="text-xs text-gray-400 mt-1">
                    {% if app.user.currentSubscription %}
                        Abonnement : <span class="text-red-600 font-medium">{{ app.user.currentSubscription.name }}</span>
                    {% else %}
                        <a href="{{ path('show_subscriptions') }}" class="text-red-600 hover:underline">Choisir un abonnement</a>
                    {% endif %}
                </div>
            </div>
        </div>

        {% for msg in app.flashes('success') %}
            <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg mb-6 text-sm">{{ msg }}</div>
        {% endfor %}
        {% for msg in app.flashes('error') %}
            <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-6 text-sm">{{ msg }}</div>
        {% endfor %}

        <form method="POST" action="{{ path('profile_update') }}" class="space-y-5">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('profile_update') }}">

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Nom d'utilisateur</label>
                <input type="text" name="username" value="{{ app.user.username }}" required
                       class="w-full px-4 py-3 rounded-lg border border-gray-200 text-sm focus:outline-none focus:border-red-400"/>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Adresse email</label>
                <input type="email" name="email" value="{{ app.user.email }}" required
                       class="w-full px-4 py-3 rounded-lg border border-gray-200 text-sm focus:outline-none focus:border-red-400"/>
            </div>

            <button type="submit"
                    class="px-6 py-3 bg-red-600 hover:bg-red-700 text-white text-sm rounded-lg transition">
                Enregistrer les modifications
            </button>
        </form>

        <hr class="my-10 border-gray-200">

        <h2 class="text-base font-semibold text-gray-900 mb-5">Changer de <span class="text-red-600">mot de passe</span></h2>

        <form method="POST" action="{{ path('profile_change_password') }}" class="space-y-5">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('change_password') }}">

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Mot de passe actuel</label>
                <input type="password" name="current_password" required
                       class="w-full px-4 py-3 rounded-lg border border-gray-200 text-sm focus:outline-none focus:border-red-400"/>
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Nouveau mot de passe</label>
                <input type="password" name="new_password" required minlength="6"
                       class="w-full px-4 py-3 rounded-lg border border-gray-200 text-sm focus:outline-none focus:border-red-400"/>
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Confirmer le nouveau mot de passe</label>
                <input type="password" name="new_password_confirm" required
                       class="w-full px-4 py-3 rounded-lg border border-gray-200 text-sm focus:outline-none focus:border-red-400"/>
            </div>

            <button type="submit"
                    class="px-6 py-3 bg-gray-800 hover:bg-gray-900 text-white text-sm rounded-lg transition">
                Changer le mot de passe
            </button>
        </form>

        <hr class="my-10 border-gray-200">

        <div class="flex gap-4 text-sm">
            <a href="{{ path('watch_history') }}" class="flex items-center gap-2 text-gray-600 hover:text-red-600">
                <svg class="h-5 w-5 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M16.2,16.2L11,13V7H12.5V12.2L17,14.9L16.2,16.2Z"/></svg>
                Voir mon historique
            </a>
            <a href="{{ path('show_my_list') }}" class="flex items-center gap-2 text-gray-600 hover:text-red-600">
                <svg class="h-5 w-5 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M17,3H7A2,2 0 0,0 5,5V21L12,18L19,21V5C19,3.89 18.1,3 17,3Z"/></svg>
                Mes playlists
            </a>
        </div>

    </main>
    {% include 'parts/structure/right-sidebar.html.twig' %}
</div>
{% endblock %}
