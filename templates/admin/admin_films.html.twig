{% extends 'base.html.twig' %}

{% block title %} Streemi - Admin - Films et séries {% endblock %}

{% block content %}
<div class="flex min-h-screen 2xl:max-w-screen-2xl 2xl:mx-auto 2xl:border-x-2 2xl:border-gray-200">
    <main class="flex-1 py-10 px-5 sm:px-10">
        <section class="flex flex-wrap items-center justify-between gap-4">
            <div>
                <a href="{{ path('admin') }}" class="text-xs text-gray-400 hover:text-red-600">← Administration</a>
                <h1 class="text-lg font-medium text-black">Gestion <span class="font-bold text-red-600">des films, séries et animés</span></h1>
            </div>
            <a href="{{ path('admin_movies_add') }}" class="flex items-center gap-2 px-4 py-2.5 bg-red-600 hover:bg-red-700 text-white rounded-lg font-medium">
                <svg class="h-5 w-5 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"/></svg>
                Ajouter un film / une série
            </a>
        </section>

        <form method="GET" class="mt-8 flex flex-col md:flex-row gap-3">
            <input name="q" value="{{ query }}" placeholder="Rechercher un titre…"
                   class="flex-1 px-4 py-2.5 rounded-lg bg-gray-100 border border-gray-200 focus:outline-none focus:border-gray-400 focus:bg-white">
            <select name="type" class="px-4 py-2.5 rounded-lg bg-gray-100 border border-gray-200 focus:outline-none focus:border-gray-400">
                <option value="">Tous les types</option>
                {% for tab in ['movie', 'serie', 'anime'] %}
                    {% set tabType = enum('App\\Enum\\CatalogTypeEnum').from(tab) %}
                    <option value="{{ tab }}" {{ tabType == type ? 'selected' }}>{{ tabType.label }}</option>
                {% endfor %}
            </select>
            <button class="px-5 py-2.5 bg-gray-800 hover:bg-black text-white rounded-lg font-medium">Filtrer</button>
            {% if query or type %}
                <a href="{{ path('admin_movies') }}" class="px-5 py-2.5 text-center rounded-lg border border-gray-300 hover:bg-gray-100">Réinitialiser</a>
            {% endif %}
        </form>

        <p class="mt-6 text-sm text-gray-500"><span class="font-semibold text-red-600">{{ medias|length }}</span> résultat{{ medias|length > 1 ? 's' }}</p>

        <div class="mt-3 overflow-x-auto border rounded-lg border-gray-300">
            <table class="min-w-full text-sm">
                <thead class="bg-gray-50 text-left text-gray-900">
                    <tr>
                        <th class="p-4 font-semibold">ID</th>
                        <th class="p-4 font-semibold min-w-[280px]">Titre</th>
                        <th class="p-4 font-semibold">Sortie</th>
                        <th class="p-4 font-semibold">Type</th>
                        <th class="p-4 font-semibold">Catégories</th>
                        <th class="p-4 font-semibold text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                {% for media in medias %}
                    {% set isAnime = media.categories|filter(c => c.nom == constant('App\\Enum\\CatalogTypeEnum::ANIMATION_CATEGORY'))|length > 0 %}
                    <tr class="bg-white hover:bg-gray-50">
                        <td class="p-4 text-gray-500">{{ media.id }}</td>
                        <td class="p-4">
                            <div class="flex items-center gap-3">
                                <img src="{{ media.coverImage }}" class="w-12 h-16 object-cover rounded" alt="">
                                <div>
                                    <p class="font-medium text-gray-900">{{ media.title }}</p>
                                    {% if media.mediaType == 'Serie' %}
                                        <p class="text-xs text-gray-400">{{ media.seasons|length }} saison{{ media.seasons|length > 1 ? 's' }}</p>
                                    {% endif %}
                                </div>
                            </div>
                        </td>
                        <td class="p-4 whitespace-nowrap">{{ media.releaseDate|date('d/m/Y') }}</td>
                        <td class="p-4">
                            <div class="flex flex-wrap gap-1">
                                {% if media.mediaType == 'Serie' %}
                                    <span class="py-1 px-2.5 bg-purple-50 text-purple-600 rounded-full text-xs font-medium">Série</span>
                                {% else %}
                                    <span class="py-1 px-2.5 bg-blue-50 text-blue-600 rounded-full text-xs font-medium">Film</span>
                                {% endif %}
                                {% if isAnime %}
                                    <span class="py-1 px-2.5 bg-orange-50 text-orange-600 rounded-full text-xs font-medium">Animé</span>
                                {% endif %}
                            </div>
                        </td>
                        <td class="p-4 text-xs text-gray-500">{{ media.categories|map(c => c.nom)|join(', ') }}</td>
                        <td class="p-4">
                            <div class="flex items-center justify-end gap-1">
                                <a href="{{ path('admin_movies_edit', {id: media.id}) }}" title="Modifier" class="p-2 rounded-lg text-blue-600 hover:bg-black/10">
                                    <svg class="h-5 w-5 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"/></svg>
                                </a>
                                {% if media.mediaType == 'Serie' %}
                                    <a href="{{ path('admin_serie_seasons', {id: media.id}) }}" title="Saisons et épisodes" class="p-2 rounded-lg text-purple-600 hover:bg-black/10">
                                        <svg class="h-5 w-5 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M3,5H9V11H3V5M5,7V9H7V7H5M11,7H21V9H11V7M11,15H21V17H11V15M5,20L1.5,16.5L2.91,15.09L5,17.17L9.59,12.59L11,14L5,20Z"/></svg>
                                    </a>
                                {% endif %}
                                <a href="{{ path('movie_detail', {id: media.id}) }}" title="Voir la fiche" class="p-2 rounded-lg text-orange-400 hover:bg-black/10">
                                    <svg class="h-5 w-5 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9M12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5Z"/></svg>
                                </a>
                                <form method="POST" action="{{ path('admin_movies_delete', {id: media.id}) }}" onsubmit="return confirm('Supprimer « {{ media.title|e('js') }} » ? Ses commentaires, saisons et épisodes seront aussi supprimés.')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_media_' ~ media.id) }}">
                                    <button type="submit" title="Supprimer" class="p-2 rounded-lg text-red-600 hover:bg-black/10">
                                        <svg class="h-5 w-5 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"/></svg>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="6" class="p-8 text-center text-gray-400">Aucun média trouvé.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        {% if pages > 1 %}
            <nav class="mt-6 flex flex-wrap justify-center gap-1">
                {% for p in 1..pages %}
                    <a href="{{ path('admin_movies', {q: query ?: null, type: type ? type.value : null, page: p}) }}"
                       class="min-w-[2.25rem] px-3 py-1.5 text-center rounded-md border {{ p == page ? 'bg-red-600 border-red-600 text-white font-semibold' : 'border-gray-300 hover:bg-gray-100' }}">{{ p }}</a>
                {% endfor %}
            </nav>
        {% endif %}
    </main>
</div>
{% endblock %}
