{% extends 'base.html.twig' %}

{% set input = 'w-full px-4 py-3 rounded-lg bg-gray-100 border border-gray-200 placeholder-gray-500 text-sm focus:outline-none focus:border-gray-400 focus:bg-white' %}
{% set isSerie = media.mediaType == 'Serie' %}

{% block title %} Streemi - Admin - {{ isNew ? 'Ajouter un média' : 'Modifier ' ~ media.title }} {% endblock %}

{% macro error(errors, field) %}
    {% if errors[field] is defined %}<p class="mt-1 text-xs text-red-600">{{ errors[field] }}</p>{% endif %}
{% endmacro %}

{% macro personRow(field, index, person, input) %}
    <div class="person-row flex flex-col sm:flex-row gap-2">
        <input name="{{ field }}[{{ index }}][name]" value="{{ person.name ?? '' }}" placeholder="Nom" class="{{ input }} sm:w-1/3">
        <input name="{{ field }}[{{ index }}][role]" value="{{ person.role ?? '' }}" placeholder="{{ field == 'staff' ? 'Fonction (ex : Réalisateur)' : 'Rôle (ex : Acteur)' }}" class="{{ input }} sm:w-1/3">
        <input name="{{ field }}[{{ index }}][image]" value="{{ person.image ?? '' }}" placeholder="URL de la photo (optionnel)" class="{{ input }} sm:flex-1">
        <button type="button" class="remove-person px-3 py-2 rounded-lg text-red-600 hover:bg-red-50" title="Retirer">✕</button>
    </div>
{% endmacro %}

{% block content %}
<div class="flex min-h-screen 2xl:max-w-screen-2xl 2xl:mx-auto 2xl:border-x-2 2xl:border-gray-200">
    <main class="flex-1 py-10 px-5 sm:px-10 max-w-5xl">
        <a href="{{ path('admin_movies') }}" class="text-xs text-gray-400 hover:text-red-600">← Liste des films et séries</a>
        <h1 class="text-lg font-medium text-black">
            {% if isNew %}Ajouter <span class="font-bold text-red-600">un film ou une série</span>
            {% else %}Modifier <span class="font-bold text-red-600">{{ media.title }}</span>{% endif %}
        </h1>
        {% if not isNew and isSerie %}
            <a href="{{ path('admin_serie_seasons', {id: media.id}) }}" class="inline-block mt-2 text-sm text-purple-600 hover:underline">Gérer les saisons et épisodes →</a>
        {% endif %}

        {% if errors %}
            <div class="mt-6 bg-red-50 border border-red-200 text-red-700 rounded-lg p-4 text-sm">
                {{ errors.form ?? 'Le formulaire contient des erreurs, corrigez les champs indiqués en rouge.' }}
            </div>
        {% endif %}

        <form method="POST" class="mt-8 space-y-8">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_media_form') }}">

            <section class="space-y-4">
                <h2 class="font-semibold text-gray-700">Informations</h2>
                <div class="flex flex-col sm:flex-row gap-4">
                    <div class="sm:w-2/3">
                        <label class="text-xs font-medium text-gray-500">Titre *</label>
                        <input name="title" value="{{ media.title }}" required maxlength="255" class="{{ input }}">
                        {{ _self.error(errors, 'title') }}
                    </div>
                    <div class="sm:w-1/3">
                        <label class="text-xs font-medium text-gray-500">Type</label>
                        {% if isNew %}
                            <select name="type" class="{{ input }}">
                                <option value="movie" {{ not isSerie ? 'selected' }}>Film</option>
                                <option value="serie" {{ isSerie ? 'selected' }}>Série</option>
                            </select>
                        {% else %}
                            <p class="px-4 py-3 rounded-lg bg-gray-50 border border-gray-200 text-gray-500">{{ isSerie ? 'Série' : 'Film' }} <span class="text-xs">(non modifiable)</span></p>
                        {% endif %}
                    </div>
                </div>
                <div>
                    <label class="text-xs font-medium text-gray-500">Description courte * <span class="text-gray-400">(affichée sur les cartes)</span></label>
                    <textarea name="short_description" rows="2" required class="{{ input }}">{{ media.shortDescription }}</textarea>
                    {{ _self.error(errors, 'short_description') }}
                </div>
                <div>
                    <label class="text-xs font-medium text-gray-500">Description longue *</label>
                    <textarea name="long_description" rows="5" required class="{{ input }}">{{ media.longDescription }}</textarea>
                    {{ _self.error(errors, 'long_description') }}
                </div>
                <div class="flex flex-col sm:flex-row gap-4">
                    <div class="sm:w-2/3">
                        <label class="text-xs font-medium text-gray-500">Image de couverture (URL) *</label>
                        <input id="cover-input" name="cover" type="url" value="{{ media.coverImage }}" required placeholder="https://…" class="{{ input }}">
                        {{ _self.error(errors, 'cover') }}
                        <img id="cover-preview" src="{{ media.coverImage }}" alt="" class="mt-3 h-40 rounded-lg object-cover {{ media.coverImage ? '' : 'hidden' }}">
                    </div>
                    <div class="sm:w-1/3">
                        <label class="text-xs font-medium text-gray-500">Date de sortie *</label>
                        <input name="release_date" type="date" value="{{ media.releaseDate ? media.releaseDate|date('Y-m-d') }}" required class="{{ input }}">
                        {{ _self.error(errors, 'release_date') }}
                    </div>
                </div>
            </section>

            <section>
                <h2 class="font-semibold text-gray-700">Catégories *</h2>
                <p class="text-xs text-gray-400">Cochez « Animation » pour qu'il apparaisse dans l'onglet Animés.</p>
                <div class="mt-3 flex flex-wrap gap-2">
                    {% for category in categories %}
                        <label class="cursor-pointer">
                            <input type="checkbox" name="categories[]" value="{{ category.id }}" class="peer hidden" {{ category in media.categories ? 'checked' }}>
                            <span class="block px-3 py-1.5 rounded-full border border-gray-300 text-sm peer-checked:bg-red-600 peer-checked:border-red-600 peer-checked:text-white">{{ category.nom }}</span>
                        </label>
                    {% endfor %}
                </div>
                {{ _self.error(errors, 'categories') }}
            </section>

            <section>
                <h2 class="font-semibold text-gray-700">Langues</h2>
                <div class="mt-3 flex flex-wrap gap-2">
                    {% for language in languages %}
                        <label class="cursor-pointer">
                            <input type="checkbox" name="languages[]" value="{{ language.id }}" class="peer hidden" {{ language in media.languages ? 'checked' }}>
                            <span class="block px-3 py-1.5 rounded-full border border-gray-300 text-sm peer-checked:bg-gray-800 peer-checked:border-gray-800 peer-checked:text-white">{{ language.nom }}</span>
                        </label>
                    {% endfor %}
                </div>
            </section>

            {% for field, label in {staff: 'Staff', casting: 'Casting'} %}
                <section>
                    <h2 class="font-semibold text-gray-700">{{ label }}</h2>
                    {{ _self.error(errors, field) }}
                    <div class="people mt-3 space-y-2" data-field="{{ field }}">
                        {% for person in attribute(media, field) %}
                            {{ _self.personRow(field, loop.index0, person, input) }}
                        {% endfor %}
                    </div>
                    <button type="button" class="add-person mt-2 text-sm text-red-600 hover:underline" data-field="{{ field }}">+ Ajouter une personne</button>
                    <template id="person-template-{{ field }}">{{ _self.personRow(field, '__index__', {}, input) }}</template>
                </section>
            {% endfor %}

            <div class="flex gap-3 pt-4 border-t border-gray-200">
                <button type="submit" class="px-6 py-3 bg-red-600 hover:bg-red-700 text-white rounded-lg font-medium">
                    {{ isNew ? 'Créer' : 'Enregistrer les modifications' }}
                </button>
                <a href="{{ path('admin_movies') }}" class="px-6 py-3 rounded-lg border border-gray-300 hover:bg-gray-100">Annuler</a>
            </div>
        </form>
    </main>
</div>

<script>
(() => {
    // Aperçu de l'image dès qu'on colle une URL
    const coverInput = document.getElementById('cover-input');
    const preview = document.getElementById('cover-preview');
    coverInput.addEventListener('input', () => {
        preview.src = coverInput.value;
        preview.classList.toggle('hidden', !coverInput.value);
    });
    preview.addEventListener('error', () => preview.classList.add('hidden'));

    // Ajout / retrait de lignes staff et casting
    let counter = Date.now();
    document.querySelectorAll('.add-person').forEach((button) => {
        button.addEventListener('click', () => {
            const field = button.dataset.field;
            const html = document.getElementById('person-template-' + field).innerHTML.replaceAll('__index__', counter++);
            document.querySelector('.people[data-field="' + field + '"]').insertAdjacentHTML('beforeend', html);
        });
    });
    document.addEventListener('click', (e) => {
        if (e.target.classList.contains('remove-person')) {
            e.target.closest('.person-row').remove();
        }
    });
})();
</script>
{% endblock %}
