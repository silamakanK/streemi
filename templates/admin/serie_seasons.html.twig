{% extends 'base.html.twig' %}

{% set input = 'px-3 py-2 rounded-lg bg-gray-100 border border-gray-200 text-sm focus:outline-none focus:border-gray-400 focus:bg-white' %}
{% set token = csrf_token('admin_seasons_' ~ serie.id) %}

{% block title %} Streemi - Admin - Saisons de {{ serie.title }} {% endblock %}

{% block content %}
<div class="flex min-h-screen 2xl:max-w-screen-2xl 2xl:mx-auto 2xl:border-x-2 2xl:border-gray-200">
    <main class="flex-1 py-10 px-5 sm:px-10 max-w-5xl">
        <a href="{{ path('admin_movies') }}" class="text-xs text-gray-400 hover:text-red-600">← Liste des films et séries</a>
        <div class="flex flex-wrap items-center justify-between gap-4">
            <h1 class="text-lg font-medium text-black">Saisons et épisodes de <span class="font-bold text-red-600">{{ serie.title }}</span></h1>
            <div class="flex gap-2 text-sm">
                <a href="{{ path('admin_movies_edit', {id: serie.id}) }}" class="px-3 py-2 rounded-lg border border-gray-300 hover:bg-gray-100">Modifier la série</a>
                <a href="{{ path('movie_detail', {id: serie.id}) }}" class="px-3 py-2 rounded-lg border border-gray-300 hover:bg-gray-100">Voir la fiche</a>
            </div>
        </div>

        <div class="mt-8 space-y-6">
            {% for season in serie.seasons %}
                <section id="saison-{{ season.id }}" class="border border-gray-200 rounded-xl overflow-hidden">
                    <header class="flex flex-wrap items-center justify-between gap-3 bg-gray-50 px-4 py-3">
                        <form method="POST" action="{{ path('admin_season_edit', {id: serie.id, seasonId: season.id}) }}" class="flex items-center gap-2">
                            <input type="hidden" name="_token" value="{{ token }}">
                            <input name="number" value="{{ season.number }}" required class="{{ input }} font-semibold">
                            <button class="text-xs text-blue-600 hover:underline">Renommer</button>
                        </form>
                        <div class="flex items-center gap-3">
                            <span class="text-xs text-gray-500">{{ season.episodes|length }} épisode{{ season.episodes|length > 1 ? 's' }}</span>
                            <form method="POST" action="{{ path('admin_season_delete', {id: serie.id, seasonId: season.id}) }}" onsubmit="return confirm('Supprimer « {{ season.number|e('js') }} » et tous ses épisodes ?')">
                                <input type="hidden" name="_token" value="{{ token }}">
                                <button class="text-xs text-red-600 hover:underline">Supprimer la saison</button>
                            </form>
                        </div>
                    </header>

                    <div class="divide-y divide-gray-100">
                        {% for episode in season.episodes %}
                            <div class="flex flex-col md:flex-row md:items-center gap-2 px-4 py-2">
                                <span class="text-xs text-gray-400 w-10 shrink-0">É{{ loop.index }}</span>
                                <form method="POST" action="{{ path('admin_episode_edit', {id: serie.id, episodeId: episode.id}) }}" class="flex flex-1 flex-col sm:flex-row gap-2">
                                    <input type="hidden" name="_token" value="{{ token }}">
                                    <input name="title" value="{{ episode.title }}" required class="{{ input }} flex-1" aria-label="Titre">
                                    <input name="duration" type="number" min="1" value="{{ episode.duration }}" required class="{{ input }} sm:w-24" aria-label="Durée en minutes" title="Durée (min)">
                                    <input name="released_at" type="date" value="{{ episode.releasedAt|date('Y-m-d') }}" required class="{{ input }}" aria-label="Date de sortie">
                                    <button class="px-3 py-2 text-xs rounded-lg text-blue-600 hover:bg-blue-50">Enregistrer</button>
                                </form>
                                <form method="POST" action="{{ path('admin_episode_delete', {id: serie.id, episodeId: episode.id}) }}" onsubmit="return confirm('Supprimer cet épisode ?')">
                                    <input type="hidden" name="_token" value="{{ token }}">
                                    <button class="px-3 py-2 text-xs rounded-lg text-red-600 hover:bg-red-50">Supprimer</button>
                                </form>
                            </div>
                        {% else %}
                            <p class="px-4 py-3 text-sm text-gray-400">Aucun épisode pour l'instant.</p>
                        {% endfor %}
                    </div>

                    <form method="POST" action="{{ path('admin_episode_add', {id: serie.id, seasonId: season.id}) }}" class="flex flex-col sm:flex-row gap-2 px-4 py-3 bg-gray-50 border-t border-gray-200">
                        <input type="hidden" name="_token" value="{{ token }}">
                        <input name="title" required placeholder="Titre du nouvel épisode" class="{{ input }} flex-1">
                        <input name="duration" type="number" min="1" required placeholder="Durée (min)" class="{{ input }} sm:w-32">
                        <input name="released_at" type="date" required value="{{ 'now'|date('Y-m-d') }}" class="{{ input }}">
                        <button class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-lg text-sm">+ Ajouter l'épisode</button>
                    </form>
                </section>
            {% else %}
                <p class="p-8 text-center text-gray-400 border border-dashed rounded-xl">Cette série n'a pas encore de saison.</p>
            {% endfor %}
        </div>

        <form method="POST" action="{{ path('admin_season_add', {id: serie.id}) }}" class="mt-6 flex flex-col sm:flex-row gap-2">
            <input type="hidden" name="_token" value="{{ token }}">
            <input name="number" placeholder="Saison {{ serie.seasons|length + 1 }}" class="{{ input }} sm:w-64">
            <button class="px-4 py-2 bg-gray-800 hover:bg-black text-white rounded-lg text-sm">+ Ajouter une saison</button>
        </form>
    </main>
</div>
{% endblock %}
